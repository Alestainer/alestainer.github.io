---
// Temporary tuning page — compare hard-core minSep values against the Poisson reference.
import BaseLayout from '../../layouts/BaseLayout.astro';
const opts = [0.032, 0.036, 0.040, 0.044, 0.058];
---
<BaseLayout title="Tune minSep" description="unlisted">
  <main class="mx-auto max-w-5xl px-4 py-8">
    <h1 class="text-xl font-semibold mb-1">Hard-core spacing candidates</h1>
    <p class="text-sm text-[var(--color-text-muted)] mb-6">Same seed throughout. Rightmost is the true Poisson reference — the target is "evener than that, but not a lattice".</p>
    <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:8px">
      {opts.map((r) => (
        <div><canvas data-r={r} width="400" height="400" class="w-full h-auto border border-[var(--color-border)] rounded"></canvas>
        <div class="text-center text-xs mt-1 font-mono">{r.toFixed(3)}</div></div>
      ))}
      <div><canvas data-r="0" width="400" height="400" class="w-full h-auto border-2 border-[var(--color-primary)] rounded"></canvas>
      <div class="text-center text-xs mt-1 font-mono text-[var(--color-primary)]">Poisson</div></div>
    </div>
  </main>
</BaseLayout>
<script>
  function mulberry32(a){return function(){a|=0;a=(a+0x6D2B79F5)|0;let t=Math.imul(a^(a>>>15),1|a);t=(t+Math.imul(t^(t>>>7),61|t))^t;return ((t^(t>>>14))>>>0)/4294967296;};}
  function poisson(rng,n){const p=[];for(let i=0;i<n;i++)p.push([rng(),rng()]);return p;}
  function hardcore(rng,n,r){const pts=[],r2=r*r;let a=0;const max=n*8000;
    while(pts.length<n&&a<max){a++;const p=[rng(),rng()];let ok=true;
      for(const q of pts){const dx=q[0]-p[0],dy=q[1]-p[1];if(dx*dx+dy*dy<r2){ok=false;break;}}
      if(ok)pts.push(p);}return pts;}
  const N=120, SEED=20260817;
  document.querySelectorAll('canvas').forEach((cv)=>{
    const c = cv as HTMLCanvasElement;
    const r = Number(c.dataset.r);
    const pts = r === 0 ? poisson(mulberry32(SEED ^ 0x9e3779b9), N)
                        : hardcore(mulberry32(SEED ^ 0x85ebca6b), N, r);
    const dpr = 2; const S = 400*dpr; c.width=S; c.height=S;
    const ctx = c.getContext('2d')!;
    ctx.fillStyle='#fff'; ctx.fillRect(0,0,S,S);
    const pad=S*0.04, inner=S-pad*2;
    ctx.fillStyle='#1e293b';
    for(const [x,y] of pts){ctx.beginPath();ctx.arc(pad+x*inner,pad+y*inner,S*0.008,0,Math.PI*2);ctx.fill();}
  });
</script>
