---
// Pilot instrument for post 001. Unlisted, not for publication.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PointPatternPicker from '../../components/figures/PointPatternPicker.astro';
---

<BaseLayout title="Pilot — which map is random?" description="Calibration pilot, unlisted.">
  <main class="mx-auto max-w-2xl px-4 py-12">
    <h1 class="text-2xl font-semibold">Quick question</h1>
    <p class="mt-3 text-[var(--color-text-muted)]">
      Two patterns of dots. One of them was generated by pure chance. Pick the one you think is
      the random one — go with your gut, there's no trick.
    </p>
    <PointPatternPicker seed={20260817} n={120} minSep={0.058} />
    <p class="mt-8 text-xs text-[var(--color-text-muted)]">
      Press <em>New pair</em> for a fresh pair. Every pair is reproducible from its seed.
    </p>
  </main>
</BaseLayout>
