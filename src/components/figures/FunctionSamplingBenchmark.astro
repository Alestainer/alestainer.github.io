---
interface Props {
  seed?: string;
  rounds?: number;
}

const {
  seed = 'anton-human-v1',
  rounds = 20,
} = Astro.props;

const params = new URLSearchParams({
  seed,
  rounds: String(rounds),
  participant: 'reader',
  v: 'blog-v1',
});

const gameUrl = `/labs/function-sampling/index.html?${params}`;
---

<figure class="function-sampling" aria-label="Playable function-sampling benchmark">
  <div class="toolbar">
    <span>Exact {rounds}-round evaluation set</span>
    <a href={gameUrl} target="_blank" rel="noopener">Open full screen ↗</a>
  </div>
  <iframe
    title="Playable function-sampling benchmark"
    src={gameUrl}
    loading="eager"
    allow="fullscreen"
  ></iframe>
</figure>

<style>
  .function-sampling {
    width: 100%;
    margin: 2rem 0;
  }

  .toolbar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--color-border, #e5e5e5);
    color: var(--color-text-muted, #666);
    font: 700 0.72rem/1.3 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: 0.025em;
    text-transform: uppercase;
  }

  .toolbar a {
    flex: none;
    color: var(--color-primary, #2457d6);
    text-decoration: none;
  }

  iframe {
    display: block;
    width: 100%;
    height: min(1040px, 82vh);
    min-height: 720px;
    border: 1px solid var(--color-border, #e5e5e5);
    background: #fff;
  }

  @media (max-width: 520px) {
    .toolbar {
      align-items: flex-start;
      flex-direction: column;
    }

    iframe {
      height: 820px;
      min-height: 0;
    }
  }
</style>
